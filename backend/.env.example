DATABASE_URL=postgresql://kolabo:kolabo@localhost:5432/kolabo
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENV=development

# Comma separated EMAIL ADDRESSES of the people who may use the admin surface,
# being the addresses those accounts registered with. EMPTY MEANS NOBODY: a
# laptop that never sets this has no admin at all and the admin screens simply
# refuse, which is the safe direction but is not an error anything reports.
# Reconciled on every boot, so removing an address here and restarting revokes
# that access.
#
# THIS WAS ADMIN_PHONES AND THE OLD NAME NO LONGER DOES ANYTHING. Leaving a
# stale ADMIN_PHONES line in a .env is not an error and not a warning, it is
# simply ignored, which means the list reads as empty and every admin is
# revoked at the next boot. If you are updating an existing file, rename the
# line and put an address on it rather than adding a second one.
#
# Case does not matter: the list is normalised the same way a registration is.
# ADMIN_EMAILS=you@example.com

# THERE IS NO SMS SETTING HERE ANY MORE. A commented SMS_GATEWAY_API_KEY sat
# on this line for as long as the phone was the login identity, and no code
# ever read it. Verification codes and password reset codes now go by email,
# through the Resend settings at the bottom of this file, so an SMS key would
# be a placeholder for a channel this product does not have.

# FedaPay, the payment gateway for the UEMOA launch markets (Benin, Togo,
# Cote d'Ivoire). See docs/PAYMENTS_FEDAPAY.md for why FedaPay and not KKiaPay,
# and for the dashboard setup this expects.
#
# LEAVING THESE UNSET TURNS PAYMENTS OFF, which is the intended state for local
# development and for the test suite: with no secret key the gateway registry
# is empty, escrow funding falls back to the in-process mock provider, and no
# real money endpoint is reachable. It is not a half-configured state.
#
# THIS FILE IS FOR A LAPTOP. The deployed environment reads deploy/.env
# instead, injected into the backend and sweeps containers by
# deploy/docker-compose.prod.yml. Editing this file changes nothing about what
# a server serves — see deploy/README.md.
#
# FEDAPAY_SECRET_KEY  the API key the backend authenticates with. Sandbox and
#   live keys are different values from different dashboards; which one is in
#   use is decided by FEDAPAY_SANDBOX, not by the key.
# FEDAPAY_PUBLIC_KEY  the publishable key, served to the web and mobile clients
#   through GET /payments/config so a key rotation is a backend deploy rather
#   than two app-store releases.
# FEDAPAY_WEBHOOK_SECRET  the endpoint secret from the dashboard's Webhooks
#   tab, prefixed wh_. NOT the same value as FEDAPAY_SECRET_KEY — signing with
#   the wrong one rejects every webhook in a way that reads like a network
#   fault. Unset makes webhook verification REFUSE rather than skip.
#
#   NOTHING REPORTS THIS ONE MISSING. GET /payments/config answers `enabled`
#   from the secret key alone, so a deployment with no webhook secret looks
#   entirely healthy until the first webhook arrives and is rejected.
# FEDAPAY_SANDBOX  true by default. Going live is an explicit false, so a
#   deployment handed live keys without being told to use them stays in the
#   test environment instead of moving real money by accident.
# FEDAPAY_SECRET_KEY=
# FEDAPAY_PUBLIC_KEY=
# FEDAPAY_WEBHOOK_SECRET=wh_...
# FEDAPAY_SANDBOX=true

# Where FedaPay sends the payer once checkout finishes. The payment intent id
# is appended as a query parameter, and it must be publicly reachable over
# HTTPS — localhost cannot be redirected to from a phone.
#
# NO WHITELIST IS REQUIRED. This line used to say the domain had to be
# whitelisted in the FedaPay dashboard. It does not: callback_url is sent per
# transaction in the create-transaction call, FedaPay documents it as
# optional, and the dashboard has no allowed-domains screen to put it in.
#
# The status FedaPay appends to this URL is not evidence, and nothing in this
# codebase treats it as such — GET /payments/checkout/{id} re-reads the
# transaction from the gateway before it settles anything. FedaPay's own
# warning: "a malicious person could mislead you by modifying the status
# directly in the URL itself."
# PAYMENT_RETURN_URL=http://localhost:5173/checkout/return

# How many times a failed payout is retried by the sweep before it stops and
# becomes a support queue item.
# PAYOUT_MAX_ATTEMPTS=5

# Where THIS API is reachable from the public internet, with no trailing slash.
# It is the only thing the OAuth callback URL is built from:
#
#     <API_PUBLIC_BASE_URL>/profiles/oauth/<platform>/callback
#
# THE DEFAULT IS http://localhost:8000, WHICH IS WRONG ON EVERY SERVER, and the
# way it is wrong is the reason this line exists. OAuth compares redirect_uri
# BYTE FOR BYTE, twice — once when the creator is sent to the consent screen
# and again at the token exchange — and both must equal what is registered in
# the platform's developer console. A deployed backend that never sets this
# sends every creator to a callback on localhost:8000, and Meta refuses with
# `redirect_uri_mismatch` before the consent screen is even drawn. The error
# names neither this variable nor the code that reads it, and nothing in the
# app reports it missing: the setting has a default, so the server boots
# perfectly happily and only the connect button is broken.
#
# It is NOT a credential, which is why it is written out here in full rather
# than left blank. Set it to the scheme and host the API actually answers on,
# and register exactly the resulting callback URL in the Meta app's "Valid
# OAuth Redirect URIs" — one character of difference, a trailing slash
# included, is a refused handshake.
# API_PUBLIC_BASE_URL=https://api.kolabo.africa

# Where the WEB APP is served from, with no trailing slash. It is the allowlist
# for where a creator may be sent after a social account connection finishes:
#
#     this origin, or a kolabo:// deep link, and nothing else.
#
# NOT THE SAME VALUE AS API_PUBLIC_BASE_URL ABOVE, and worth reading twice if
# you are setting both. That one is where the API answers, which is where a
# platform sends the browser back to. This one is where the person is, which is
# where they have to end up afterwards. On a real deployment they are two
# different hosts.
#
# LEAVING IT UNSET BREAKS NOTHING AND FIXES NOTHING, which is exactly how it
# goes unnoticed. The default below is the local Vite server, so a deployed
# backend refuses the real web app's redirect_to, writes one WARNING line
# naming the value it dropped, and completes the connection anyway. Nobody is
# turned away and nothing raises: creators simply land on the callback's JSON
# instead of back on their profile page, which reads as "the connect button is
# broken" and names none of this.
#
# It is not a credential. Set it to the scheme and host the web app answers on.
# WEB_PUBLIC_BASE_URL=https://kolabo.africa

# YouTube Data API v3 key. Public channel data needs only a key, with no OAuth
# and no app review, so setting this turns on YouTube profile auto fill.
# Create it in the Google Cloud console, enable "YouTube Data API v3", then
# restrict the key to that one API.
# YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Meta Graph API credentials for Instagram and Facebook profile auto fill. Both
# read through graph.facebook.com and share one long-lived token and one API
# version. Instagram uses Business Discovery, which returns another creator's
# public stats BY HANDLE but only when the call is made through your own
# Instagram Business/Creator account — set its id below (Facebook needs no such
# id and runs on the token alone). Token permissions: instagram_basic and
# pages_show_list for Instagram, pages_read_engagement for a Facebook Page.
#
# META_GRAPH_VERSION IS A PERISHABLE VALUE. Meta keeps each Graph API version
# for at least two years from its release and then stops answering it, so the
# string below is correct on the day it is written and wrong later — this
# example shipped v19.0 (released 23 January 2024) until well past its 21 May
# 2026 expiry. Check the version is still live before copying it, and note the
# date beside it when you change it.
#
# IT PINS THE OAUTH PROVIDER TOO, since the Meta app credentials below arrived.
# A retired version no longer merely stops filling profiles in: it stops the
# consent dialog and the token exchange, so nobody can connect an account.
# META_GRAPH_TOKEN=your_long_lived_graph_token
# INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000
# META_GRAPH_VERSION=v26.0

# The Meta APP's own credentials, from developers.facebook.com > your app >
# Settings > Basic. These turn ON the Facebook OAuth provider — the handshake
# that lets a creator connect their own Page, at
# POST /profiles/oauth/facebook/start.
#
# A DIFFERENT THING FROM META_GRAPH_TOKEN ABOVE, and worth being sure which you
# are setting. That token belongs to KOLABO and reads public data about a
# handle the creator typed; nobody authorised anything. These two are how the
# app ASKS a creator for permission, and what comes back is a token belonging
# to them, over their own Page.
#
# BOTH OR NEITHER. With either one missing the provider is not registered at
# all and /profiles/oauth/facebook/start answers `oauth_platform_unsupported`,
# exactly as it did before the provider existed — that is the intended state
# for a laptop and for CI, and it is why the test suite sets neither. An app id
# with no secret cannot complete a token exchange, so registering on the id
# alone would only move the failure to after the creator has already granted
# permissions.
#
# THE SECRET IS A REAL SECRET. Anyone holding it can mint tokens as the Kolabo
# app. It goes in deploy/.env on the server, never in this repository, an
# image, or a screenshot — and it is rotated in the Meta console the moment it
# is pasted anywhere it should not have been.
#
# Three things must be true in the Meta console before this works, and none of
# them is visible from here:
#   * the app requests pages_show_list and pages_read_engagement, and those
#     permissions have been granted by App Review (Development mode works for
#     the app's own admins, testers and developers without review, which is how
#     the demo video for that review gets recorded);
#   * the exact callback URL built from API_PUBLIC_BASE_URL above is listed
#     under Valid OAuth Redirect URIs;
#   * the app is a Business-type app with Business Verification completed,
#     which is what allows the Pages permissions to be requested at all.
# META_APP_ID=1888079209231475
# META_APP_SECRET=

# TikTok Login Kit: the app's own client key and secret, which are what switch
# the TikTok OAuth provider on. Same gate as the Meta pair above, both
# required, and with either empty POST /profiles/oauth/tiktok/start answers
# oauth_platform_unsupported.
#
# Three things must be true in the TikTok for Developers portal, and none of
# them is visible from here:
#   * the app has the Login Kit product with the scopes user.info.basic,
#     user.info.profile and user.info.stats, and no others — TikTok's review
#     guidelines state that an unused scope left selected delays the result;
#   * the exact callback URL built from API_PUBLIC_BASE_URL above is listed
#     under Login Kit's Redirect URI, on the Web tab;
#   * the Terms of Service URL, the Privacy Policy URL and the website URL
#     have all passed URL property verification, which for a single domain is
#     one DNS TXT record.
#
# WHICH PAIR: a first-time app has to be demonstrated from a SANDBOX, which
# carries its own client key and secret. Carry the sandbox pair while the app
# is in review, swap to the production pair once TikTok approves. See
# deploy/.env.example for the full note.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Google sign in: the OAuth client ids POST /auth/google will accept a token
# for, comma separated. Google Cloud console > APIs and Services > Credentials
# > OAuth 2.0 Client IDs.
#
# ONE PER CLIENT, ALL ON ONE LINE. Web, Android and iOS are three separate
# OAuth clients with three separate ids, and Google stamps whichever one asked
# into the token's aud claim. Setting only one verifies that client and refuses
# the others, which reaches a user as a sign in button that works on the
# website and not on the phone.
#
# NOT A SECRET, AND THERE IS NO CLIENT SECRET TO GO WITH IT. This is an ID
# token flow: the client obtains a token from Google and posts it, and the
# server only ever reads it. There is no code exchange, no redirect uri and no
# callback route, so there is nothing a client secret could do. The ids are
# public by design and already ship inside both apps.
#
# NOT THE SAME THING AS YOUTUBE_API_KEY OR THE META APP CREDENTIALS ABOVE, even
# though two of the three come out of the same console. The YouTube key reads
# public channel data on our own behalf. These ids say which applications a
# sign in token may have been issued to, and that check is the whole of what
# stops a correctly signed Google token issued to SOMEBODY ELSE'S app from
# signing its holder into Kolabo.
#
# Unset means the feature is unavailable rather than unrestricted:
# POST /auth/google answers 503 auth_google_unavailable and the clients hide
# the button. Same rule as every other integration in this file.
# GOOGLE_CLIENT_IDS=111111.apps.googleusercontent.com,222222.apps.googleusercontent.com

# Anthropic API key for AI drafted profile bios. Left unset, the endpoint
# reports the feature as unavailable rather than half working.
# ANTHROPIC_API_KEY=

# Transactional email, through Resend. THE ONLY OUTBOUND CHANNEL THIS PRODUCT
# HAS: registration codes, password reset codes and every notification email.
#
# MAIL IS OPTIONAL AND THE APP RUNS WITHOUT IT. With no API key there is no
# provider to build, so both senders fall back to their logging stand-ins, the
# same rule the YouTube, Meta and Anthropic keys above follow. Nothing refuses
# to boot over an unset mail provider, and on a laptop the verification code is
# printed to the log as [DEV OTP] so a signup can be completed with no
# credentials at all.
#
# ON A REAL DEPLOYMENT THAT IS NOT GOOD ENOUGH. With the address as the login
# identity, an unset key means every new user is told a code is on its way and
# none is sent, and nobody can complete a registration or recover a password.
# It is optional for a laptop and effectively required for a server.
#
# RESEND_API_KEY  the provider key from the Resend dashboard. A REAL SECRET:
#   it belongs in deploy/.env on the server, never in this repository, an
#   image, or a screenshot.
# MAIL_FROM  the envelope sender, display name included. Its domain has to be
#   verified in Resend first or every send is refused.
# MAIL_REPLY_TO  optional. Where a reply should land when that is not the
#   From address. Unset simply omits the header.
# RESEND_API_KEY=
# MAIL_FROM=Kolabo <codes@auth.kolaboafrica.com>
# MAIL_REPLY_TO=

# Copy this file to backend/.env and fill in real values. backend/.env is
# gitignored and, since the .dockerignore was added, never enters an image.
