{
  "expo": {
    "name": "Kolabo",
    "slug": "kolabo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kolabo",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.kolabo.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kolabo.app",
      "edgeToEdgeEnabled": true
    },
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Kolabo needs access to your photos so you can add a profile picture and upload the content you deliver for a campaign.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.kolabo.mocktar.com",
      "eas": {
        "projectId": "aacd1962-68bf-4700-a0cc-f1b33c6cfc6f"
      }
    }
  }
}
