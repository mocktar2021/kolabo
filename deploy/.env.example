# Copy to deploy/.env on the server and fill in. deploy/.env is gitignored.
#
# EVERY VALUE MARKED "CHANGE THIS" IS A REAL VULNERABILITY IF LEFT AS SHIPPED.
# The defaults in backend/app/core/config.py exist so a laptop runs with no
# setup; they are public, they are in git, and on a public hostname they mean
# anyone can mint a valid session token or read an encrypted ID document.

# ---------------------------------------------------------------- database
POSTGRES_USER=kolabo
POSTGRES_DB=kolabo
# CHANGE THIS. Not published to the host in the prod compose, but it is still
# the credential for every row of user and payment data.
POSTGRES_PASSWORD=

# ------------------------------------------------------------------- app
ENV=development

# CHANGE THIS. Signs every session token. The committed default is
# "change-me" — with it, anybody who has read this repository can forge a
# token for any account, including an admin.
#   openssl rand -hex 32
JWT_SECRET=

# CHANGE THIS. Encrypts verification documents at rest, and the default is a
# real working key committed to the repo — so it protects nothing until it is
# replaced. Must be a valid Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=

# Comma-separated EMAIL ADDRESSES who get admin, being the addresses those
# accounts registered with. EMPTY MEANS NOBODY — a deployment that forgets this
# locks the admin surface rather than opening it, which is the safe direction
# but does mean you cannot resolve a dispute or run a sweep by hand until you
# set it. Reconciled on every boot: removing an address here and redeploying
# revokes that access.
#
# RENAMED FROM ADMIN_PHONES when the email address became the login identity.
# An .env still carrying the old name is not rejected, it is ignored, and an
# ignored admin list revokes every admin at the next boot. Rename the line.
#
# Case does not matter: the list is normalised the same way a registration is.
ADMIN_EMAILS=you@example.com

# The browser origin allowed to call the API. Exactly the web hostname, with
# the scheme, no trailing slash.
CORS_ORIGINS=https://kolabo.mocktar.com

# Where THIS API answers from on the public internet, no trailing slash. It is
# the only thing the social OAuth callback URL is built from:
#
#     <API_PUBLIC_BASE_URL>/profiles/oauth/<platform>/callback
#
# THIS LINE WAS MISSING FROM THIS FILE, AND THAT IS A LIVE PRODUCTION BUG
# rather than a tidying job. The setting defaults to http://localhost:8000 and
# nothing else supplies it: it is not in docker-compose.prod.yml either, and
# the api service takes its environment from this file. So the deployed server
# boots perfectly happily and builds every redirect_uri against localhost.
# OAuth compares redirect_uri byte for byte, twice, so Meta refuses the
# handshake with redirect_uri_mismatch before the consent screen is even
# drawn, and nothing in the logs names this variable or the code that reads it.
#
# ADDING IT HERE FIXES NOTHING THAT IS ALREADY RUNNING. deploy/.env on the
# server is not regenerated from this example, so the same line has to be
# added there by hand and the api container restarted.
API_PUBLIC_BASE_URL=https://api.kolabo.mocktar.com

# ---------------------------------------------------------------- payments
# Sandbox keys from https://sandbox.fedapay.com — Developers -> API keys.
# NO LIVE KEYS IN THIS ENVIRONMENT.
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=

# From the dashboard's Webhooks tab, prefixed wh_. NOT the same value as
# FEDAPAY_SECRET_KEY — mixing them up rejects every webhook with a signature
# error that reads like a network fault. Unset makes verification REFUSE
# rather than skip, so webhooks simply will not settle until this is set.
FEDAPAY_WEBHOOK_SECRET=

# Keep true here. false moves real money.
FEDAPAY_SANDBOX=true

# Where FedaPay returns the payer, and MUST be an http(s) url — the gateway
# validates the field and refuses anything else outright.
#
# NOT MERELY A DEFAULT ANY MORE. It used to apply only when a client sent no
# return url of its own, which the web app always does, so a wrong value here
# would have sat unnoticed. It is now the return url of every MOBILE payment
# as well: the app asks for its own kolabo:// deep link, a gateway will not
# accept a custom scheme, and checkout._gateway_return_url substitutes this.
# A typo here is a broken checkout on the phone, not a dormant setting.
#
# There is NO domain to whitelist. An earlier version of this comment said
# this had to be on a domain registered in the FedaPay dashboard or payers
# would land on a signup page; that was false and it sent somebody looking for
# a screen that does not exist. #146 and #149 removed the same claim from
# deploy/README.md and docs/PAYMENTS_FEDAPAY.md and missed this copy.
# Verified against FedaPay's documentation: callback_url is sent per
# transaction and is documented as optional.
PAYMENT_RETURN_URL=https://kolabo.mocktar.com/checkout/return

PAYOUT_MAX_ATTEMPTS=5

# ---------------------------------------------------------------- sweeps
# How often the payout retry / auto-release / refund / dispute-escalation jobs
# run, in seconds. 300 is frequent enough that a failed payout retries within
# five minutes and gentle enough that it is invisible on a small box.
SWEEP_INTERVAL_SECONDS=300

# ------------------------------------------------------------------- build
# Baked into the web bundle at BUILD time. Changing it needs a rebuild:
#   docker compose -f docker-compose.prod.yml up -d --build web
VITE_API_URL=https://api.kolabo.mocktar.com

# The WEB OAuth client id for Google sign in, and only the web one. It is the
# browser half of GOOGLE_CLIENT_IDS further down: that list is every client the
# API will accept a token from (web, Android, iOS), this is the single id the
# browser identifies itself with. The web id must appear in both, or the button
# works and the server refuses the token it produced.
#
# BAKED IN AT BUILD TIME LIKE THE LINE ABOVE, with the same consequence and one
# extra trap. Adding it to this file changes nothing that is already running:
# deploy/.env on the server is not regenerated from this example, so the same
# line has to be added there BY HAND, and then the web image REBUILT rather
# than restarted. A restart re-serves the bundle that was compiled without it.
#
# NOT A SECRET. An OAuth client id is public by construction and there is no
# client secret beside it, because the browser posts an ID token and the server
# only reads it. Google Cloud console -> APIs and Services -> Credentials ->
# OAuth 2.0 Client IDs -> the Web application client. Its Authorized JavaScript
# origins must list the web hostname exactly, scheme and all, or Google refuses
# to draw the button.
#
# EMPTY IS A REAL SETTING AND IS THE RIGHT ONE UNTIL THE IDS EXIST. The button
# does not render at all, rather than rendering and failing. Same rule as
# GOOGLE_CLIENT_IDS below, which makes POST /auth/google answer 503.
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------- tls
# Let's Encrypt expiry notices.
ACME_EMAIL=tairou.mocktar@gmail.com

# ------------------------------------------------------- optional integrations
# Unset means the feature reports itself unavailable rather than half working.
# YOUTUBE_API_KEY=
# META_GRAPH_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# ANTHROPIC_API_KEY=

# The Meta APP's own credentials, which are what switch the Facebook OAuth
# provider ON. A DIFFERENT THING FROM META_GRAPH_TOKEN above: that token
# belongs to Kolabo and reads public data about a handle somebody typed, while
# these two are how the app asks a creator for permission over their own Page.
#
# Also missing from this file until now, with the same consequence as the line
# further up: no deployment following this example could ever offer the connect
# button. BOTH are required, and with either one empty the provider is not
# registered at all and POST /profiles/oauth/facebook/start answers
# oauth_platform_unsupported, exactly as it did before the provider existed.
#
# META_APP_SECRET IS A REAL SECRET. Anyone holding it can mint tokens as the
# Kolabo app. It lives in deploy/.env on the server and nowhere else.
META_APP_ID=
META_APP_SECRET=

# Google sign in: the OAuth client ids POST /auth/google accepts a token for,
# comma separated, ONE PER CLIENT (web, Android, iOS). Google stamps whichever
# client asked into the token's aud claim, so a single id here refuses every
# other surface.
#
# Not a secret, and there is no client secret beside it: the flow posts an ID
# token and the server only reads it. Empty means the endpoint answers 503 and
# both apps hide the button, which is the right state until the ids exist.
# GOOGLE_CLIENT_IDS=

# Transactional email, through Resend. Optional like the rest of this
# section: with no key there is no sender to build, the address verification
# email reports itself unavailable, and the app boots and serves normally.
#
# RESEND_API_KEY is a real secret and goes in deploy/.env, not here. MAIL_FROM
# needs a domain already verified in Resend or every send is refused.
# MAIL_REPLY_TO is optional and unset simply omits the header.
# RESEND_API_KEY=
# MAIL_FROM=Kolabo <codes@auth.kolaboafrica.com>
# MAIL_REPLY_TO=
