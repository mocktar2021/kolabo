# Where the app looks for the API.
#
# Copy this file to mobile/.env and set the value for YOUR machine. `.env` is
# gitignored, so the address of your laptop never enters a commit.
#
# THE ONE RULE THAT CATCHES EVERYBODY: a phone running Expo Go cannot reach
# "localhost". On the phone, localhost is the phone — so the default in
# app.json works for a simulator running on the same machine as the API and
# for nothing else. Use your machine's LAN address instead. Find it with
# `ipconfig` on Windows (IPv4 Address, under the Wi-Fi adapter) or
# `ipconfig getifaddr en0` on macOS.
#
# EXPO_PUBLIC_* variables are inlined into the bundle when Metro builds it, so
# after changing this, restart with `npx expo start -c` — without the cache
# clear you keep running the old value and the change looks like it did
# nothing.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Serving the API to a phone also needs the API to accept non-local callers:
# start it as `uvicorn app.main:app --reload --host 0.0.0.0 --port 8000`. The
# bare `--reload` in backend/README.md binds 127.0.0.1, which is reachable
# from the dev machine and nowhere else. (Docker already binds 0.0.0.0.)
#
# CORS is deliberately NOT part of this: it is a browser rule, and a native
# app is not a browser. If a request fails from the phone but works from the
# web app, the cause is the address or the firewall, never CORS.

# The Google sign in client ids, and what leaving them out does.
#
# EMPTY IS A REAL SETTING AND THE RIGHT ONE UNTIL THE CLIENTS EXIST: the
# button is not drawn at all and the app behaves exactly as it did before the
# feature existed. It is not a broken button, it is an absent one, which is
# the same rule the backend applies when GOOGLE_CLIENT_IDS is empty and
# /auth/google answers 503.
#
# These two OVERRIDE expo.extra.googleWebClientId and
# expo.extra.googleIosClientId in app.json, exactly as EXPO_PUBLIC_API_URL
# overrides expo.extra.apiBaseUrl above, and they are inlined at bundle time
# in the same way, so the same `npx expo start -c` applies.
#
# THE WEB ONE IS NOT A MISTAKE. It is the WEB OAuth client, the same id the
# browser build uses, and the native library takes it as its server client id:
# it is what makes Google issue an ID token at all. The IOS one is the iOS
# OAuth client and is only read on iOS. There is no Android line because an
# Android client is matched by package name and signing certificate rather
# than by any value in the bundle.
#
# NEITHER OF THESE WORKS IN EXPO GO. Google sign in needs native code, so the
# button only functions in a development build. See mobile/MOBILE_BUILD.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
