# Copy to deploy/.env on the server and fill in. deploy/.env is gitignored.
#
# EVERY VALUE MARKED "CHANGE THIS" IS A REAL VULNERABILITY IF LEFT AS SHIPPED.
# The defaults in backend/app/core/config.py exist so a laptop runs with no
# setup; they are public, they are in git, and on a public hostname they mean
# anyone can mint a valid session token or read an encrypted ID document.

# ---------------------------------------------------------------- database
POSTGRES_USER=kolabo
POSTGRES_DB=kolabo
# CHANGE THIS. Not published to the host in the prod compose, but it is still
# the credential for every row of user and payment data.
POSTGRES_PASSWORD=

# ------------------------------------------------------------------- app
ENV=development

# CHANGE THIS. Signs every session token. The committed default is
# "change-me" — with it, anybody who has read this repository can forge a
# token for any account, including an admin.
#   openssl rand -hex 32
JWT_SECRET=

# CHANGE THIS. Encrypts verification documents at rest, and the default is a
# real working key committed to the repo — so it protects nothing until it is
# replaced. Must be a valid Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=

# Comma-separated phone numbers who get admin. EMPTY MEANS NOBODY — a
# deployment that forgets this locks the admin surface rather than opening it,
# which is the safe direction but does mean you cannot resolve a dispute or run
# a sweep by hand until you set it. Reconciled on every boot: removing a number
# here and redeploying revokes that access.
ADMIN_PHONES=+229XXXXXXXX

# The browser origin allowed to call the API. Exactly the web hostname, with
# the scheme, no trailing slash.
CORS_ORIGINS=https://kolabo.mocktar.com

# ---------------------------------------------------------------- payments
# Sandbox keys from https://sandbox.fedapay.com — Developers -> API keys.
# NO LIVE KEYS IN THIS ENVIRONMENT.
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=

# From the dashboard's Webhooks tab, prefixed wh_. NOT the same value as
# FEDAPAY_SECRET_KEY — mixing them up rejects every webhook with a signature
# error that reads like a network fault. Unset makes verification REFUSE
# rather than skip, so webhooks simply will not settle until this is set.
FEDAPAY_WEBHOOK_SECRET=

# Keep true here. false moves real money.
FEDAPAY_SANDBOX=true

# Where FedaPay returns the payer, and MUST be an http(s) url — the gateway
# validates the field and refuses anything else outright.
#
# NOT MERELY A DEFAULT ANY MORE. It used to apply only when a client sent no
# return url of its own, which the web app always does, so a wrong value here
# would have sat unnoticed. It is now the return url of every MOBILE payment
# as well: the app asks for its own kolabo:// deep link, a gateway will not
# accept a custom scheme, and checkout._gateway_return_url substitutes this.
# A typo here is a broken checkout on the phone, not a dormant setting.
#
# There is NO domain to whitelist. An earlier version of this comment said
# this had to be on a domain registered in the FedaPay dashboard or payers
# would land on a signup page; that was false and it sent somebody looking for
# a screen that does not exist. #146 and #149 removed the same claim from
# deploy/README.md and docs/PAYMENTS_FEDAPAY.md and missed this copy.
# Verified against FedaPay's documentation: callback_url is sent per
# transaction and is documented as optional.
PAYMENT_RETURN_URL=https://kolabo.mocktar.com/checkout/return

PAYOUT_MAX_ATTEMPTS=5

# ---------------------------------------------------------------- sweeps
# How often the payout retry / auto-release / refund / dispute-escalation jobs
# run, in seconds. 300 is frequent enough that a failed payout retries within
# five minutes and gentle enough that it is invisible on a small box.
SWEEP_INTERVAL_SECONDS=300

# ------------------------------------------------------------------- build
# Baked into the web bundle at BUILD time. Changing it needs a rebuild:
#   docker compose -f docker-compose.prod.yml up -d --build web
VITE_API_URL=https://api.kolabo.mocktar.com

# ------------------------------------------------------------------- tls
# Let's Encrypt expiry notices.
ACME_EMAIL=tairou.mocktar@gmail.com

# ------------------------------------------------------- optional integrations
# Unset means the feature reports itself unavailable rather than half working.
# YOUTUBE_API_KEY=
# META_GRAPH_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# ANTHROPIC_API_KEY=

# Transactional email, through Resend. Optional like the rest of this
# section: with no key there is no sender to build, the address verification
# email reports itself unavailable, and the app boots and serves normally.
#
# RESEND_API_KEY is a real secret and goes in deploy/.env, not here. MAIL_FROM
# needs a domain already verified in Resend or every send is refused.
# MAIL_REPLY_TO is optional and unset simply omits the header.
# RESEND_API_KEY=
# MAIL_FROM=Kolabo <codes@auth.kolaboafrica.com>
# MAIL_REPLY_TO=
