DATABASE_URL=postgresql://kolabo:kolabo@localhost:5432/kolabo
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENV=development
# SMS_GATEWAY_API_KEY=
# MOBILE_MONEY_PROVIDER_KEYS=

# YouTube Data API v3 key. Public channel data needs only a key, with no OAuth
# and no app review, so setting this turns on YouTube profile auto fill.
# Create it in the Google Cloud console, enable "YouTube Data API v3", then
# restrict the key to that one API.
# YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Meta Graph API credentials for Instagram and Facebook profile auto fill. Both
# read through graph.facebook.com and share one long-lived token and one API
# version. Instagram uses Business Discovery, which returns another creator's
# public stats BY HANDLE but only when the call is made through your own
# Instagram Business/Creator account — set its id below (Facebook needs no such
# id and runs on the token alone). Token permissions: instagram_basic and
# pages_show_list for Instagram, pages_read_engagement for a Facebook Page.
# META_GRAPH_TOKEN=your_long_lived_graph_token
# INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000
# META_GRAPH_VERSION=v19.0

# Anthropic API key for AI drafted profile bios. Left unset, the endpoint
# reports the feature as unavailable rather than half working.
# ANTHROPIC_API_KEY=

# Copy this file to backend/.env and fill in real values. backend/.env is
# gitignored and, since the .dockerignore was added, never enters an image.
