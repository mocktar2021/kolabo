VITE_API_URL=http://localhost:8000

# Which deployment this build is for. Only the exact value "production"
# suppresses the non-production banner; anything else, including leaving this
# empty, shows it. That direction is deliberate: a production site wearing a
# development banner is noticed and fixed in minutes, while a development site
# that looks like production is the quiet failure the banner exists to catch.
# On a server this is not set by hand, it is fed from ENV in deploy/.env.
VITE_KOLABO_ENV=development

# The Google sign in button renders only when this is set, so leaving it
# empty is how a laptop runs without one. Vite bakes it in at build time,
# which for `npm run dev` means restarting the dev server after changing it.
# Add http://localhost:5173 to the client's Authorized JavaScript origins in
# the Google console or the button will refuse to draw.
VITE_GOOGLE_CLIENT_ID=
